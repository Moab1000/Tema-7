---
const { headline, text, icon } = Astro.props;
---

<article>
  <img src={icon} alt="" />
  <h3>{headline}</h3>
  <p>{text}</p>
</article>

<style>
  article {
    max-width: 300px;
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
  }

  img {
    width: 100%;
    height: 350px;
    margin-bottom: 1rem;
    background-color: #eee;
    object-fit: cover;
  }
</style>
