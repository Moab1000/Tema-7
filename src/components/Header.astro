---
const { headline, text } = Astro.props;
---

<header>
  <div>
    <h1>{headline}</h1>
    <p>{text}</p>
    <a class="knap" href="">Ansøg nu</a>
  </div>
</header>

<style>
  header {
    width: 100%;
    height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-image: url("/Header.png");
    background-size: cover;
    background-position: center;
  }
  div {
    padding: 0 10%;
  }
  p {
    font-size: larger;
  }
</style>
